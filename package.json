{
  "name": "lacquer",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "dotenv -e .env -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "dotenv -e .env -- playwright test",
    "db:generate": "pnpm --filter @lacquer/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @lacquer/db migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @lacquer/db seed",
    "job:demo": "dotenv -e .env -- pnpm --filter @lacquer/worker demo"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.54.0",
    "eslint-plugin-svelte": "^3.14.0",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.4.1",
    "dotenv-cli": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "argon2"
    ],
    "overrides": {
      "@fastify/swagger-ui>@fastify/static": "10.1.2"
    }
  }
}
