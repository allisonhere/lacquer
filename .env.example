# Copy to .env for native development. Compose has matching local defaults.
# REQUIRED (development examples only)
DATABASE_URL=postgresql://lacquer:lacquer_dev@localhost:5432/lacquer
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:5173
SESSION_SECRET=development-only-change-me-32-characters-minimum
# Production: NODE_ENV=production, HTTPS APP_URL, generated SESSION_SECRET.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
INSTALLATION_CURRENCY=USD
API_HOST=0.0.0.0
API_PORT=3001
WORKER_PORT=3002
# Requests per minute per client IP; raise for a busy front desk behind one NAT.
RATE_LIMIT_MAX=120
LOG_LEVEL=info
# Used only by SvelteKit's server-side proxy. Never exposed in client code.
API_INTERNAL_URL=http://127.0.0.1:3001
# Node adapter uses these for the public web server:
ORIGIN=http://localhost:5173
PORT=5173
HOST=0.0.0.0
# OPTIONAL: leave unused settings absent (not empty).
EMAIL_PROVIDER=disabled
# EMAIL_FROM=noreply@example.test
# SMTP_URL=smtp://localhost:1025
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=lacquer
# OBJECT_STORAGE_ACCESS_KEY=development
# OBJECT_STORAGE_SECRET_KEY=development-only
# Reserved for future integrations; no provider is implemented or called.
# STRIPE_SECRET_KEY=...
# SQUARE_ACCESS_TOKEN=...
# Integration tests REQUIRE a dedicated database ending in _test.
TEST_DATABASE_URL=postgresql://lacquer:lacquer_dev@localhost:5432/lacquer_test
TEST_REDIS_URL=redis://localhost:6379/15
